# ==========================================================================
# Dipesh Patel Web Studio - Environment Variables & Email Setup
# ==========================================================================

# SMTP Email Server Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dipesh.patel.dev@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_ENCRYPTION=tls

# Notification Email Destinations
FROM_EMAIL=dipesh.patel.dev@gmail.com
RECIPIENT_EMAIL=dipesh.patel.dev@gmail.com
NOTIFY_EMAIL=dipesh.patel.dev@gmail.com

# Studio Environment Settings
PORT=8085
NODE_ENV=production

# ==========================================================================
# Resume Studio & Cloud Storage (Vercel)
# ==========================================================================
# Automatically set when you connect Vercel Blob in Vercel Dashboard (Storage -> Create Database -> Blob)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx

# Custom Owner Passcode for /admin & /admin/resume (Optional - defaults to Dipesh_Admin_Resume_Secure_2026!)
RESUME_ADMIN_SECRET=Dipesh_Admin_Resume_Secure_2026!
