{
  "version": 2,
  "builds": [
    {
      "src": "api/enquiry.js",
      "use": "@vercel/node"
    },
    {
      "src": "!(api)/**",
      "use": "@vercel/static"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "https://dipesh-patel-portfolio.vercel.app"
        }
      ],
      "destination": "https://dipesh-patel.vercel.app/$1",
      "statusCode": 301
    }
  ],
  "routes": [
    {
      "src": "/api/enquiry",
      "dest": "/api/enquiry.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
